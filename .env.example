# ── Streaming Server Agent config ────────────────────────────────────────────
# Copy to .env and fill in. The agent runs as root, so treat AGENT_TOKEN like a
# root password.

# REQUIRED. Shared bearer token the control panel must send.
# Generate: openssl rand -hex 32
AGENT_TOKEN=

# Bind address. Default 127.0.0.1 (loopback only). To accept remote calls from
# the control panel, bind to a PRIVATE/VPN interface if you can, e.g.:
#   AGENT_HOST=10.0.0.5
# Only use 0.0.0.0 with AGENT_ALLOWED_IPS set.
AGENT_HOST=127.0.0.1

# Port.
AGENT_PORT=8787

# Comma-separated IP allowlist — your control panel's egress IP(s). Strongly
# recommended whenever AGENT_HOST is not loopback.
#   AGENT_ALLOWED_IPS=203.0.113.10,203.0.113.11
AGENT_ALLOWED_IPS=

# Set to 1 ONLY if the agent sits behind a trusted reverse proxy that sets
# X-Forwarded-For. Otherwise leave unset (clients could spoof their IP).
AGENT_TRUST_PROXY=

# Where your deploy/*.sh scripts live.
AGENT_BIN_DIR=/usr/local/bin

# Site root.
AGENT_WWW_DIR=/var/www

# Max concurrent operations. 1 = serialize (safest — avoids nginx/DB races).
AGENT_MAX_CONCURRENT=1

# How long finished jobs (and logs) stay queryable, ms. Default 1h.
AGENT_JOB_RETENTION_MS=3600000

# Per-operation hard timeout, ms. Default 20m (SSL can be slow).
AGENT_JOB_TIMEOUT_MS=1200000

# Hard timeout for backup/restore ops (big-site archive + Spaces transfer), ms.
# Default 12h.
AGENT_BACKUP_TIMEOUT_MS=43200000

# Friendly server name shown in API responses.
AGENT_SERVER_NAME=

# ── Self-enrollment (optional) ───────────────────────────────────────────────
# Set by the portal's install command so the agent registers itself on startup.
# PORTAL_ENROLL_URL is the portal's enroll endpoint; ENROLL_TOKEN is a
# short-lived owner-scoped token. Leave blank for manual registration.
PORTAL_ENROLL_URL=
ENROLL_TOKEN=
# Links the agent to the portal's live install view (set by the install command).
PROVISION_ID=

# Override only if the portal can't reach this agent at http://AGENT_HOST:PORT
# (e.g. behind NAT/proxy). Full URL including scheme and port.
AGENT_ADVERTISE_URL=